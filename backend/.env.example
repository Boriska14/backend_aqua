# Application
NODE_ENV=development
PORT=3000
APP_NAME=AquaSafe
CORS_ORIGINS=http://localhost:4200,http://localhost:3000
PUBLIC_VERIFY_URL=http://localhost:4200/verify
LOG_LEVEL=info
DEFAULT_LOCALE=fr

# PostgreSQL / PostGIS
DATABASE_URL=postgresql://aquasafe:aquasafe_dev_password@localhost:5432/aquasafe?schema=public

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aquasafe-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=10
SIGNED_URL_TTL_SECONDS=300

# Security & Auth
JWT_ACCESS_SECRET=replace-with-at-least-32-chars-access-secret-key
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=replace-with-at-least-32-chars-refresh-secret-key
JWT_REFRESH_TTL_DAYS=30
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
IP_HASH_SALT=replace-with-random-ip-hash-salt-for-signalements

# Pilot Operational Parameters (defaults, overridden by DB parameters where applicable)
DUPLICATE_RADIUS_M=15
PUBLIC_MAP_CLUSTER_THRESHOLD=2000
PUBLIC_MAP_CACHE_TTL_SECONDS=60

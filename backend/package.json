    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.0.0",
    "nestjs-pino": "^4.3.0",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.14.1",
